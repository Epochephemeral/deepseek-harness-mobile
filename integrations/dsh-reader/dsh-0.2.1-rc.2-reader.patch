diff --git a/packages/api/session-controller/src/reader.ts b/packages/api/session-controller/src/reader.ts
--- /dev/null
+++ b/packages/api/session-controller/src/reader.ts
@@ -0,0 +1,144 @@
+/** Opt-in, presentation-only reader projection. Never feed this into raw replay. */
+import type { JsonValue } from '@deepseek-ai/dsh-util-values'
+import type { SessionAssistantStreamBaseline, SessionAssistantStreamFrame, SessionReaderPage, SessionReaderPageRequest, SessionWireEvent } from './types.ts'
+
+type ObjectValue = { [key: string]: JsonValue }
+const object = (value: unknown): ObjectValue => value !== null && typeof value === 'object' && !Array.isArray(value) ? value as ObjectValue : {}
+const pick = (value: ObjectValue, keys: string[]): ObjectValue => Object.fromEntries(keys.filter(key => value[key] !== undefined).map(key => [key, value[key]!]))
+const brief = (value: unknown): string | undefined => typeof value === 'string' ? value.slice(0, 240) : undefined
+
+function content(value: unknown): JsonValue[] {
+  if (!Array.isArray(value)) return []
+  return value.flatMap((raw): JsonValue[] => {
+    const block = object(raw)
+    if (block.type === 'text') return [{ type: 'text', text: block.text ?? '' }]
+    // Durable references only; never inline image/file bytes or opaque metadata.
+    if (block.type === 'image' || block.type === 'file') {
+      return [{ type: block.type, attachment: pick(object(block.attachment), ['attachmentId', 'bytes', 'id', 'name', 'mediaType', 'size', 'byteLength', 'width', 'height', 'path', 'sha256']) }]
+    }
+    return []
+  })
+}
+function message(raw: unknown): ObjectValue {
+  const value = object(raw)
+  return { ...pick(value, ['id', 'role', 'toolCallId', 'isError']), source: pick(object(value.source), ['kind']), content: content(value.content) }
+}
+
+/** Preserve every raw sequence position, explicitly representing excluded records. */
+export function readerEvent(event: SessionWireEvent): SessionWireEvent {
+  const data = object(event.data)
+  let projected: ObjectValue | undefined
+  switch (event.type) {
+    case 'user/message':
+      if (['user', 'user-rpc'].includes(String(object(data.source).kind))) projected = message(data)
+      break
+    case 'assistant/message':
+      projected = { ...pick(data, ['turn', 'step', 'interrupted']), message: message(data.message), reader: { omitted: ['stream', 'reasoning', 'replayState'] } }
+      break
+    case 'assistant/attempt': {
+      const texts: string[] = []
+      for (const raw of Array.isArray(data.stream) ? data.stream : []) {
+        const row = object(raw)
+        if (row.type === 'text-chunks' && Array.isArray(row.texts)) {
+          for (const text of row.texts) if (typeof text === 'string') texts.push(text)
+        } else if (row.type === 'chunk') {
+          const chunk = object(row.chunk)
+          if (chunk.type === 'text-delta' && typeof chunk.text === 'string') texts.push(chunk.text)
+        }
+      }
+      if (texts.length > 0) projected = { ...pick(data, ['turn', 'step']), message: { role: 'assistant', content: [{ type: 'text', text: texts.join('') }] }, reader: { uncommittedAttempt: true, omitted: ['stream', 'reasoning'] } }
+      break
+    }
+    case 'tool/call': {
+      let description: string | undefined
+      // Never parse unbounded args merely to summarize them.
+      if (typeof data.arguments === 'string' && data.arguments.length <= 16384) {
+        try {
+          const args = object(JSON.parse(data.arguments))
+          description = brief(args.description) ?? brief(args.query) ?? brief(args.file_path) ?? brief(args.path) ?? brief(args.command)
+        } catch { /* Malformed model arguments still have a useful tool name. */ }
+      }
+      projected = { ...pick(data, ['turn', 'step', 'callId', 'name']), reader: { argumentsOmitted: true }, ...(description === undefined ? {} : { description }) }
+      break
+    }
+    case 'tool/result': {
+      const raw = object(data.message)
+      const refs = content(raw.content).filter(block => object(block).type !== 'text')
+      const error = object(data.error)
+      projected = {
+        ...pick(data, ['turn', 'step']),
+        message: { ...pick(raw, ['id', 'role', 'toolCallId', 'isError']), source: pick(object(raw.source), ['kind', 'callId']), content: refs },
+        reader: { outputOmitted: true, status: raw.isError === true ? 'error' : 'completed' },
+        ...(data.error === undefined ? {} : { error: { ...pick(error, ['name', 'code']), ...(brief(error.reason) === undefined ? {} : { reason: brief(error.reason)! }) } }),
+      }
+      break
+    }
+    case 'deliverables/presented':
+      projected = { ...pick(data, ['turn', 'callId']), files: Array.isArray(data.files) ? data.files.map(file => pick(object(file), ['path', 'description', 'name', 'mediaType', 'size'])) : [] }
+      break
+    case 'turn/start':
+      projected = pick(data, ['turn'])
+      break
+    case 'turn/end':
+      projected = pick(data, ['turn', 'status'])
+      if (data.reason !== undefined) {
+        const reason = object(data.reason)
+        projected.reason = typeof data.reason === 'string' ? data.reason : {
+          ...pick(reason, ['kind']),
+          ...(reason.reason === undefined ? {} : { reason: pick(object(reason.reason), ['kind', 'reason']) }),
+          ...(reason.error === undefined ? {} : { error: pick(object(reason.error), ['code', 'message', 'retryable']) }),
+        }
+      }
+      if (data.error !== undefined) {
+        const error = object(data.error)
+        projected.error = typeof data.error === 'string' ? data.error.slice(0, 2000) : pick(error, ['name', 'code', 'message', 'reason'])
+      }
+      break
+  }
+  if (projected === undefined) return { type: 'reader/skip', seq: event.seq, time: event.time, data: null, ignorable: true }
+  return { type: event.type, seq: event.seq, time: event.time, data: projected,
+    ...(event.surfaceOp === undefined ? {} : { surfaceOp: event.surfaceOp }),
+    ...(event.sourceEventSeqs === undefined ? {} : { sourceEventSeqs: event.sourceEventSeqs }) }
+}
+
+/** Count raw positions, not messages, so an enormous tool-only turn stays bounded. */
+export function readerPage(events: readonly SessionWireEvent[], request: Pick<SessionReaderPageRequest, 'maxRows' | 'maxBytes' | 'beforeSeq'>, throughSeq: number): SessionReaderPage {
+  const maxRows = request.maxRows ?? 128
+  const maxBytes = request.maxBytes ?? 262144
+  const end = Math.min(throughSeq + 1, request.beforeSeq ?? throughSeq + 1)
+  const records: SessionReaderPage['records'][number][] = []
+  let bytes = 2
+  let cut = end
+  for (let index = end - 1; index >= 0 && records.length < maxRows; index--) {
+    const record = { type: 'event' as const, event: readerEvent(events[index]!) }
+    const size = Buffer.byteLength(JSON.stringify(record), 'utf8') + (records.length > 0 ? 1 : 0)
+    if (records.length > 0 && bytes + size > maxBytes) break
+    records.push(record)
+    bytes += size
+    cut = index
+  }
+  records.reverse()
+  return { records, hasMore: cut > 0, reader: { version: 1, fromSeq: cut, throughSeq: end - 1, nextBeforeSeq: cut, bytes, oversized: bytes > maxBytes, rawDetails: 'session/page' } }
+}
+
+/** Sparse process-local revisions: public text and tool identity only, never args. */
+export function readerFrame(frame: SessionAssistantStreamFrame): SessionAssistantStreamFrame | undefined {
+  if (frame.type !== 'chunk') return frame
+  const chunk = object(frame.chunk)
+  if (chunk.type === 'text-delta') return { ...frame, chunk: pick(chunk, ['type', 'index', 'text']) }
+  if (chunk.type === 'tool-call-delta' && typeof chunk.name === 'string') return { ...frame, chunk: { ...pick(chunk, ['type', 'index', 'id', 'name']), argumentsDelta: '' } }
+  return undefined
+}
+
+/** Reconnect baseline retains compact public text runs without historical reasoning. */
+export function readerBaseline(baseline: SessionAssistantStreamBaseline): SessionAssistantStreamBaseline {
+  if (!baseline.activeAttempt) return baseline
+  const stream = baseline.activeAttempt.stream.flatMap((raw): JsonValue[] => {
+    const row = object(raw)
+    if (row.type === 'text-chunks') return [pick(row, ['type', 'time0', 'index', 'dt', 'texts'])]
+    if (row.type === 'tool-call-chunks' && row.name !== undefined) return [{ ...pick(row, ['type', 'time0', 'index', 'id', 'name']), dt: [], args: [''] }]
+    if (row.type === 'chunk' && object(row.chunk).type === 'text-delta') return [{ type: 'chunk', time: row.time!, chunk: pick(object(row.chunk), ['type', 'index', 'text']) }]
+    return []
+  })
+  return { revision: baseline.revision, activeAttempt: { ...baseline.activeAttempt, stream } }
+}
diff --git a/packages/api/session-controller/tests/reader.host.spec.ts b/packages/api/session-controller/tests/reader.host.spec.ts
--- /dev/null
+++ b/packages/api/session-controller/tests/reader.host.spec.ts
@@ -0,0 +1,59 @@
+import { describe, expect, it } from 'vitest'
+import { readerBaseline, readerEvent, readerFrame, readerPage } from '../src/reader.ts'
+import type { SessionWireEvent } from '../src/types.ts'
+const event = (type: string, data: SessionWireEvent['data'], seq = 0): SessionWireEvent => ({ type, data, seq, time: 1 })
+
+describe('reader projection v1', () => {
+  it('keeps human prompts and all public assistant text but excludes injected context and replay', () => {
+    expect(readerEvent(event('user/message', { source: { kind: 'user-rpc' }, content: [{ type: 'text', text: 'human' }] })).data).toMatchObject({ content: [{ type: 'text', text: 'human' }] })
+    expect(readerEvent(event('user/message', { source: { kind: 'context' }, content: [{ type: 'text', text: 'secret' }] })).type).toBe('reader/skip')
+    const result = readerEvent(event('assistant/message', { turn: 1, stream: ['SECRET'], message: { source: { kind: 'model', replayState: 'SECRET' }, content: [{ type: 'reasoning', text: 'SECRET' }, { type: 'text', text: 'first' }, { type: 'text', text: 'second' }] } }))
+    expect(JSON.stringify(result)).not.toContain('SECRET')
+    expect(result.data).toMatchObject({ message: { content: [{ type: 'text', text: 'first' }, { type: 'text', text: 'second' }] } })
+  })
+  it('keeps public failed-attempt text and usable attachment identity', () => {
+    const attempt = readerEvent(event('assistant/attempt', { turn: 1, step: 1, stream: [{ type: 'reasoning-chunks', texts: ['SECRET'] }, { type: 'text-chunks', texts: ['partial', ' answer'] }] }))
+    expect(attempt.data).toMatchObject({ message: { content: [{ type: 'text', text: 'partial answer' }] }, reader: { uncommittedAttempt: true } })
+    const image = readerEvent(event('user/message', { source: { kind: 'user' }, content: [{ type: 'image', attachment: { attachmentId: 'img', bytes: 123, width: 2, height: 3, mediaType: 'image/png', data: 'SECRET' } }] }))
+    expect(image.data).toMatchObject({ content: [{ type: 'image', attachment: { attachmentId: 'img', bytes: 123 } }] })
+    expect(JSON.stringify(image)).not.toContain('SECRET')
+  })
+  it('marks tool omissions honestly and retains errors and deliverables', () => {
+    const call = readerEvent(event('tool/call', { callId: 'c', name: 'bash', arguments: JSON.stringify({ description: 'Run test', command: 'SECRET' }) }))
+    expect(call.data).toMatchObject({ description: 'Run test', reader: { argumentsOmitted: true } })
+    expect(JSON.stringify(call)).not.toContain('SECRET')
+    const result = readerEvent(event('tool/result', { message: { toolCallId: 'c', isError: true, content: [{ type: 'text', text: 'SECRET' }] }, error: { name: 'Error', code: 'FAIL', reason: 'failed' }, meta: { secret: 'SECRET' } }))
+    expect(result.data).toMatchObject({ message: { content: [] }, error: { reason: 'failed' }, reader: { outputOmitted: true, status: 'error' } })
+    expect(JSON.stringify(result)).not.toContain('SECRET')
+    expect(readerEvent(event('deliverables/presented', { turn: 1, callId: 'c', files: [{ path: '/tmp/a.png', description: 'Image' }] })).data).toMatchObject({ files: [{ path: '/tmp/a.png' }] })
+  })
+  it('bounds huge tool-only turns, preserves contiguous paging and exact UTF8 byte accounting', () => {
+    const events = Array.from({ length: 7000 }, (_, seq) => event('request/header', { bulk: 'x'.repeat(2000) }, seq))
+    const page = readerPage(events, {}, 6999)
+    expect(page.records).toHaveLength(128)
+    expect(page.reader).toMatchObject({ fromSeq: 6872, throughSeq: 6999, nextBeforeSeq: 6872, oversized: false })
+    expect(page.reader!.bytes).toBe(Buffer.byteLength(JSON.stringify(page.records)))
+    const prior = readerPage(events, { beforeSeq: page.reader!.nextBeforeSeq, maxBytes: 500 }, 6999)
+    expect(prior.records.at(-1)!.event.seq).toBe(6871)
+    expect(prior.reader!.bytes).toBeLessThanOrEqual(500)
+    expect(prior.records.every((row, index, rows) => index === 0 || row.event.seq === rows[index - 1]!.event.seq + 1)).toBe(true)
+  })
+  it('never truncates an oversized public message and handles empty/before-zero', () => {
+    const events = [event('assistant/message', { message: { content: [{ type: 'text', text: '文'.repeat(2000) }] } })]
+    const page = readerPage(events, { maxBytes: 100 }, 0)
+    expect(page.reader!.oversized).toBe(true)
+    expect(page.records).toHaveLength(1)
+    expect(page.hasMore).toBe(false)
+    expect(readerPage(events, { beforeSeq: 0 }, 0).reader).toMatchObject({ fromSeq: 0, throughSeq: -1, nextBeforeSeq: 0 })
+    expect(readerPage([], {}, -1).records).toEqual([])
+  })
+  it('filters live bulk and reconnect reasoning while retaining public text and source watermarks', () => {
+    const base = { type: 'chunk', revision: 9, index: 8, time: 1, attemptId: 'a' } as const
+    expect(readerFrame({ ...base, attemptId: base.attemptId as never, chunk: { type: 'reasoning-delta', text: 'SECRET' } })).toBeUndefined()
+    expect(readerFrame({ ...base, attemptId: base.attemptId as never, chunk: { type: 'tool-call-delta', id: 'c', name: 'bash', argumentsDelta: 'SECRET' } })).toMatchObject({ revision: 9, chunk: { name: 'bash', argumentsDelta: '' } })
+    const baseline = readerBaseline({ revision: 9, activeAttempt: { attemptId: 'a' as never, startedAfterSeq: -1, turn: 1, step: 1, nextIndex: 8, stream: [{ type: 'reasoning-chunks', texts: ['SECRET'] }, { type: 'text-chunks', index: 0, time0: 1, dt: [], texts: ['public'] }] } })
+    expect(JSON.stringify(baseline)).not.toContain('SECRET')
+    expect(baseline.activeAttempt!.nextIndex).toBe(8)
+    expect(baseline.activeAttempt!.stream).toHaveLength(1)
+  })
+})
